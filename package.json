{
  "name": "@openvitals/landing-page",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing landing page for OpenVitals.",
  "homepage": "https://openvitals.health/",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenVitals-MTU/landing-page.git"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "prestart": "mkdir -p .next/standalone/.next && rm -rf .next/standalone/public .next/standalone/.next/static && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.3"
  }
}
